// Host packages vendored from Terminal-3/trinity release testnet-v1.0.12
// (81f207c00): host:interfaces@2.4.0 and host:tenant@2.0.0. Importing
// http-with-placeholders puts this contract in the tenant-http-placeholders
// world. Re-vendor from the release you deploy to if it changes.
package z:tenant-flight@0.6.1;

world tenant-flight {
    import host:tenant/tenant-context@2.0.0;
    import host:interfaces/logging@2.4.0;
    import host:interfaces/kv-store@2.4.0;
    import host:interfaces/http@2.4.0;                    // search (no PII)
    import host:interfaces/http-with-placeholders@2.4.0;  // booking (PII via placeholders)

    export contracts;
}

interface contracts {
    /// Standard 3-field envelope used by all contracts callable from the node.
    record generic-input {
        input:        option<list<u8>>,
        user-profile: option<list<u8>>,
        context:      option<list<u8>>,
    }

    /// The customer saves their own traveller record: title, phone and, unless the
    /// passport comes from the Private Doc Scanner, their passport (with date of
    /// birth and sex). Name and email always come from their T3N profile.
    /// Refused on a delegated call. Input: see examples/. Output: { saved, has_passport }
    save-traveller: func(req: generic-input) -> result<list<u8>, string>;

    /// The customer deletes their own traveller record. Refused on a delegated call.
    /// Output: { deleted }
    forget-traveller: func(req: generic-input) -> result<list<u8>, string>;

    /// Search Duffel for flights. No PII.
    /// Input:  { origin, destination, departure_date, cabin_class, adult_count }
    /// Output: { offers: [{ id, total_amount, total_currency, expires_at, passenger_ids }] }
    search-offers: func(req: generic-input) -> result<list<u8>, string>;

    /// Book an offer for the calling customer. The input carries no passenger details.
    /// Input:  { offer_id, passenger_id, total_amount, total_currency, scanner_request_id? }
    /// Output: { id, pnr, status }
    book-offer: func(req: generic-input) -> result<list<u8>, string>;
}
